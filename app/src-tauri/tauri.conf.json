{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "做T决策台",
  "version": "0.1.0",
  "identifier": "com.ttrade.desk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1425",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "做T决策台",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 820,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "autoT",
    "copyright": "© 2026 autoT",
    "category": "Finance",
    "shortDescription": "A股做T决策台",
    "longDescription": "A股短线做T决策与复盘工具：实时行情、regime 判定、信号与成本门槛、手工回填与交割单导入。",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
