{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "做T决策台",
  "version": "0.1.0",
  "identifier": "com.ttrade.desk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1425",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "做T决策台",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 820,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
